<?xml version="1.0" encoding="utf-8"?>
<!-- Settle keeps nothing in Android backups or Smart Switch transfers. Its library index refers
     to MediaStore rows that change on a new phone; the library is rebuilt from Google Drive
     instead (ADR-003). allowBackup alone doesn't stop device transfer on some OEM devices
     (developer.android.com/identity/data/autobackup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
