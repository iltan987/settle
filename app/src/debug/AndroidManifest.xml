<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets on-device tests start a backup from adb. DUMP is held by the
             shell, not by apps, so nothing else on the phone can send it. -->
        <receiver
            android:name=".DebugBackupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.iltan.settle.debug.BACK_UP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
